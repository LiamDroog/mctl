# Template: install-display.sh fills in the user and the binary path.
[Unit]
Description=mctl display on the composite output
After=systemd-user-sessions.service network-online.target
Wants=network-online.target
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
User=@USER@
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=WLR_LIBINPUT_NO_DEVICES=1
Environment=RUST_LOG=info
ExecStart=/usr/bin/cage -- @BIN@ --kiosk
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
